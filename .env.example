# Last Day environment. Copy to .env and fill in. Never commit real values.

# --- Core ---
# Postgres connection string.
DATABASE_URL=postgres://lastday:lastday@localhost:5432/lastday
# Max connections in the app's Postgres pool.
DATABASE_POOL_SIZE=10
# Encrypts connection credentials at rest (AES-256-GCM). At least 16 characters. Changing it makes saved credentials unreadable.
MASTER_KEY=dev-master-key-change-me
# adapter-node 6 no longer reads ORIGIN. Behind a proxy, derive the origin from forwarded headers:
PROTOCOL_HEADER=
HOST_HEADER=
# Set to 1 to run SQL migrations and bootstrap users/connections when the server starts.
AUTO_MIGRATE=0
# Overrides where the .sql migration files are read from (defaults to src/lib/server/db/migrations).
MIGRATIONS_DIR=
# Shown by /api/health.
APP_VERSION=0.0.1
# Force the session cookie Secure flag on (1) or off (0). Default: on when NODE_ENV=production.
COOKIE_SECURE=
# Show the judge login on the sign-in page (1/0). Default: on outside production.
DEMO_LOGIN_HINT=

# --- First users (created by `pnpm db:migrate` / AUTO_MIGRATE) ---
# Required in production. In development they default to admin@lastday.local / lastday-admin.
ADMIN_EMAIL=admin@lastday.local
ADMIN_PASSWORD=lastday-admin
# Optional judge login scoped to the demo company. Development default: judge@lastday.local / judge-demo.
JUDGE_EMAIL=judge@lastday.local
JUDGE_PASSWORD=judge-demo

# --- Connections (optional: seeded into the Connections page, editable there) ---
# Keycloak: confidential client with a service account (realm-management: view-users, manage-users).
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Mattermost: system admin personal access token.
MATTERMOST_BASE_URL=
MATTERMOST_ADMIN_TOKEN=
# GitHub organization (a connection is only seeded when GITHUB_ORG is set). GITHUB_REPOS is a comma list of owner/repo.
GITHUB_API_URL=https://api.github.com
GITHUB_ORG=
GITHUB_TOKEN=
GITHUB_REPOS=
# Vultr account API.
VULTR_API_URL=https://api.vultr.com/v2
VULTR_API_KEY=

# --- AI (Vultr Serverless Inference, OpenAI-compatible) ---
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# --- Re-check ---
# Overrides the Settings re-check delay (seconds) when set; handy for demos.
RECHECK_DELAY_SECONDS=
