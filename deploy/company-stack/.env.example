# Copy to .env. Never commit real values.
# Public hostnames: sslip.io resolves <anything>.<ip-with-dashes>.sslip.io to that IP, e.g. VM IP 203.0.113.10.
KEYCLOAK_HOST=sso.203-0-113-10.sslip.io
MATTERMOST_HOST=chat.203-0-113-10.sslip.io

POSTGRES_PASSWORD=change-me-postgres
KC_DB_PASSWORD=change-me-keycloak-db
MM_DB_PASSWORD=change-me-mattermost-db

# Keycloak master-realm admin (console login).
KC_ADMIN_PASSWORD=change-me-keycloak-admin
# Secret of the `last-day` client in realm `company`. Paste the same value into Last Day's Keycloak connection.
LASTDAY_CLIENT_SECRET=change-me-long-random-secret

# Pin of the Mattermost Team Edition image. 12.0.1 is the newest tag in the reference but the image is UNVERIFIED; 11.11.3 is the safe fallback.
MATTERMOST_VERSION=11.11.3
